# Copie para .env e ajuste. O .env nunca vai para o Git.

# Django
DJANGO_SECRET_KEY=gere-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Senha do Postgres usada pelo docker-compose
POSTGRES_PASSWORD=troque-esta-senha

# DOU via INLABS — crie uma conta gratuita em https://inlabs.in.gov.br
INLABS_EMAIL=
INLABS_SENHA=

# Avisos: um resumo por dia, por e-mail, com o que casou com seus filtros de alerta.
# Sem AVISOS_EMAIL_PARA, o resumo vai só para o log.
AVISOS_EMAIL_PARA=
AVISOS_HORA=7
# Gmail: ative a verificação em duas etapas e crie uma "senha de app" em
# https://myaccount.google.com/apppasswords. Use-a em EMAIL_HOST_PASSWORD (nunca a senha da conta).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Endereço do painel usado nos links do e-mail
SITE_URL=http://localhost:8000

# Token para assinar o calendário: http://localhost:8000/calendario.ics?token=...
CALENDARIO_TOKEN=

# Coleta
COLETA_BAIXAR_ARQUIVOS=true
COLETA_INTERVALO_SEG=1.0
# Intervalo do agendador, em segundos (10800 = 3 horas)
INTERVALO_COLETA_SEG=10800
