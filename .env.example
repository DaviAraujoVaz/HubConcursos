# Copie para .env e ajuste. O .env nunca vai para o Git.

# Django
DJANGO_SECRET_KEY=gere-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Senha do Postgres usada pelo docker-compose
POSTGRES_PASSWORD=troque-esta-senha

# DOU via INLABS — crie uma conta gratuita em https://inlabs.in.gov.br
INLABS_EMAIL=
INLABS_SENHA=

# Avisos no Telegram (opcional). Sem isso, os avisos aparecem só no log.
# 1) Fale com @BotFather no Telegram, /newbot, copie o token.
# 2) Mande uma mensagem qualquer para o seu bot.
# 3) Abra https://api.telegram.org/bot<TOKEN>/getUpdates e copie o "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Token para assinar o calendário: http://localhost:8000/calendario.ics?token=...
CALENDARIO_TOKEN=

# Coleta
COLETA_BAIXAR_ARQUIVOS=true
COLETA_INTERVALO_SEG=1.0
# Intervalo do agendador, em segundos (10800 = 3 horas)
INTERVALO_COLETA_SEG=10800
